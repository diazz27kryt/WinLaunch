<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101014"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/content_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.37" />

    <!-- Left utility panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/launcher_shortcuts_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:background="#202025"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/content_split"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/winlaunch_wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="WINLAUNCH"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:letterSpacing="0.08"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/winlaunch_build_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="BETA TEST 0.1"
            android:textColor="#AFAFB8"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            app:layout_constraintTop_toBottomOf="@id/winlaunch_wordmark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/left_panel_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#45454D"
            app:layout_constraintTop_toBottomOf="@id/winlaunch_build_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/ic_px_book"
            android:text="@string/mcl_tab_wiki"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/left_panel_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/social_media_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:drawableStart="@drawable/ic_social_media"
            android:text="@string/mcl_button_social_media"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/news_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:drawableStart="@drawable/ic_px_gamepad"
            android:text="@string/mcl_option_customcontrol"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/social_media_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:drawableStart="@drawable/ic_px_java_run"
            android:text="@string/main_install_jar_file"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/custom_control_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/share_logs_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:drawableStart="@drawable/ic_px_sharelog"
            android:text="@string/main_share_logs"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/install_jar_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:drawableStart="@drawable/ic_px_folder"
            android:text="@string/mcl_button_open_directory"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/share_logs_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/winlaunch_left_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="BLACK  /  WHITE  /  LIQUID GLASS"
            android:textColor="#888891"
            android:textSize="9sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/open_files_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main game card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/launcher_hero_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#24242B"
        android:padding="20dp"
        app:layout_constraintStart_toEndOf="@id/content_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/hero_eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="MINECRAFT  JAVA EDITION"
            android:textColor="#B8B8C2"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Твой мир начинается здесь"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/hero_eyebrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/hero_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Выбери сборку и возвращайся в игру"
            android:textColor="#B8B8C2"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/hero_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/hero_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/hero_subtitle"
            app:layout_constraintBottom_toTopOf="@id/mc_version_spinner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="#303039"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_1sdp"
            app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_32sdp"
            app:layout_constraintBottom_toTopOf="@id/play_button"
            app:layout_constraintEnd_toStartOf="@id/edit_profile_button"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="10dp"
            android:background="#303039"
            android:contentDescription="Настроить профиль сборки"
            android:padding="12dp"
            android:src="@drawable/ic_px_edit"
            app:layout_constraintBottom_toTopOf="@id/play_button"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:text="@string/main_play"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
